# Copiar a .env y rellenar valores. No subir .env al repositorio.
# Perfil de Spring (recomendado: dev para entorno local).
SPRING_PROFILES_ACTIVE=dev
# Puerto del backend.
SERVER_PORT=8081
# DB_URL (opcional en dev, default: jdbc:postgresql://localhost:5432/mv_services_v1)
# DB_USERNAME (opcional en dev, default: postgres)
# DB_PASSWORD (obligatorio)
# JWT_SECRET (obligatorio, ej. clave Base64 para HS256)
# JWT_EXPIRATION_MS (opcional, default: 86400000 = 24h)
# CORS_ALLOWED_ORIGINS (opcional, CSV; default local: http://localhost:5173)

DB_URL=
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
JWT_EXPIRATION_MS=
CORS_ALLOWED_ORIGINS=http://localhost:5173
